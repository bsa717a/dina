# Derek's initial password (username: derek). Never put this in the URL.
ACCESS_CODE=change-me

# Long random secret used to sign the session cookie (32+ characters)
SESSION_SECRET=replace-with-a-long-random-secret

# OpenAI
OPENAI_API_KEY=sk-...
# Routine chat / CoS tools (mail, calendar, light Q&A)
OPENAI_MODEL_CHAT=gpt-4.1-nano
# Morning ritual, markets research, church verification search
OPENAI_MODEL_RESEARCH=gpt-4.1
# Legacy alias for chat model if OPENAI_MODEL_CHAT unset
# OPENAI_MODEL=gpt-4.1-nano

# Public app URL used for absolute links and cookie security.
# Local: http://localhost:8080
# ngrok: https://your-subdomain.ngrok-free.dev
APP_URL=http://localhost:8080

# PostgreSQL (local Homebrew / Postgres.app / Docker)
# Docker: postgresql://dina:dina@localhost:5432/dina
DATABASE_URL="postgresql://derekfowler@localhost:5432/dina"

# Web Push (generate with: npm run generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server bind
HOST=0.0.0.0
PORT=8080

# Microsoft 365 (app-only client credentials — same Entra app as mcp-servers)
# Never commit real secrets. Rotate CLIENT_SECRET if it was ever stored in source.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER_EMAIL=derek@4studentlives.com
MS_SHAREPOINT_SITE=4studentlives.sharepoint.com:/sites/4SLTechProjects
MS_SHAREPOINT_DEFAULT_FOLDER=Dev Docs

# Google (personal Gmail + Calendar) — OAuth refresh token
# Run: npm run google-oauth  (requires GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
# Put the OAuth consent screen in Production so the refresh token does not expire in 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=you@gmail.com
# Optional label shown in UI / tools (default: personal)
# GOOGLE_LABEL=personal
# Optional redirect used by google-oauth-setup.mjs (must match OAuth client)
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/oauth2/callback

# Attention Engine — shared secret for launchd / cron scans (POST /api/attention/scan)
# Generate with: openssl rand -hex 32
ATTENTION_SCAN_SECRET=

# GitHub — multi-account (credentials and allowlists are per account; never shared)
# Prefer separate GitHub App installations; fine-grained read-only PATs are fine for v1.
GITHUB_ACCOUNTS=personal,4studentlives

GITHUB_PERSONAL_TOKEN=
# Owner login/org — with no allowlist (or *), Dina reads ALL repos for this owner
GITHUB_PERSONAL_OWNER=bsa717a
# Optional: restrict to specific repos instead of all
# GITHUB_PERSONAL_ALLOWED_REPOSITORIES=owner1/repo-a,owner1/repo-b
# Optional label override (defaults to account id)
# GITHUB_PERSONAL_LABEL=personal
# Or GitHub App for this account:
# GITHUB_PERSONAL_APP_ID=
# GITHUB_PERSONAL_INSTALLATION_ID=
# GITHUB_PERSONAL_APP_PRIVATE_KEY=

GITHUB_4STUDENTLIVES_TOKEN=
GITHUB_4STUDENTLIVES_OWNER=4StudentLives
# GITHUB_4STUDENTLIVES_ALLOWED_REPOSITORIES=4StudentLives/beacon,4StudentLives/platform
# GITHUB_4STUDENTLIVES_LABEL=4studentlives
# GITHUB_4STUDENTLIVES_APP_ID=
# GITHUB_4STUDENTLIVES_INSTALLATION_ID=
# GITHUB_4STUDENTLIVES_APP_PRIVATE_KEY=

# ========================================
# Telnyx RCS/SMS (derek@4studentlives.com)
# ========================================
# Teammates text ONE RCS Dina — old Dina stays the project manager and roster source of truth.
# Flow: Telnyx inbound → roster lookup → Grok Bot Dina webhook → Telnyx outbound reply.

# Telnyx API key (v2 key from portal.telnyx.com — never commit)
TELNYX_API_KEY=

# RCS agent ID (4StudentLives verified brand)
# Example: 42257dc9-586a-4f72-bba3-6b816d1ec6ed
TELNYX_RCS_AGENT_ID=42257dc9-586a-4f72-bba3-6b816d1ec6ed

# SMS/RCS phone number in E.164 format
TELNYX_SMS_FROM=+14352382071

# Messaging profile ID (ties the phone number to the RCS agent)
# Example: 4001a055-5081-43e2-8b5e-d41eb0cf866e
TELNYX_MESSAGING_PROFILE_ID=4001a055-5081-43e2-8b5e-d41eb0cf866e

# Telnyx webhook signature verification secret (from messaging profile settings)
# If Telnyx does not provide one, leave blank and signature verification will be skipped
# TELNYX_WEBHOOK_SIGNING_SECRET=

# ========================================
# Grok Bot Dina Handoff
# ========================================
# When set, inbound messages are forwarded to Grok Bot Dina for processing.
# When unset, inbound messages are logged but not forwarded (allows testing the pipe).

# Grok Bot Dina webhook URL (e.g. https://grok-bot-dina.example.com/webhook)
# GROK_BOT_DINA_WEBHOOK_URL=

# Shared secret for authenticating with Grok Bot Dina
# GROK_BOT_DINA_WEBHOOK_SECRET=
